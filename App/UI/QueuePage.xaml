<Page
    x:Class="FilmField.Views.QueuePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FilmField.Views">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Margin="24,16,24,12">
      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <TextBlock Text="{x:Bind L('播放队列')}" FontSize="20" FontFamily="{StaticResource AppUiFontBold}" FontWeight="Bold" />
        <TextBlock x:Name="CountText" FontSize="13" Opacity="0.55" VerticalAlignment="Center" />
      </StackPanel>
    </Grid>

    <StackPanel
        x:Name="EmptyState"
        Grid.Row="1"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Spacing="6">
      <TextBlock Text="{x:Bind L('队列为空')}" FontSize="16" HorizontalAlignment="Center" Opacity="0.8" />
      <TextBlock Text="{x:Bind L('拖放视频文件到窗口，或用控制条上的打开按钮加入队列')}" FontSize="13" HorizontalAlignment="Center" Opacity="0.5" />
    </StackPanel>

    <ListView
        x:Name="QueueList"
        Grid.Row="1"
        Margin="16,0,16,16"
        SelectionMode="Single"
        IsItemClickEnabled="True"
        ItemClick="QueueList_ItemClick">
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="local:QueueEntry">
          <Grid Padding="8,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon
                Grid.Column="0"
                FontSize="12"
                Glyph="&#xE768;"
                Margin="0,0,8,0"
                Visibility="{x:Bind PlayingVisibility}" />
            <TextBlock Grid.Column="1" Text="{x:Bind DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button
                Grid.Column="2"
                Click="RemoveButton_Click"
                Background="Transparent"
                BorderThickness="0"
                Padding="6"
                ToolTipService.ToolTip="{x:Bind RemoveTooltip}">
              <FontIcon FontSize="12" Glyph="&#xE74D;" />
            </Button>
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
  </Grid>
</Page>
