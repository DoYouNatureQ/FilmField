<Page
    x:Class="FilmField.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FilmField.Views">

  <Page.Resources>
    <DataTemplate x:Key="HistoryPosterTemplate" x:DataType="local:HistoryEntry">
      <Grid Width="164" Margin="8,8,8,14">
        <Grid.RowDefinitions>
          <RowDefinition Height="246" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            CornerRadius="10"
            Background="{ThemeResource CardPlaceholderBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
          <Grid>
            <FontIcon
                Glyph="&#xE8B9;"
                FontSize="30"
                Opacity="0.22"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
            <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill" />
            <Border
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="8"
                Padding="6,2,8,2"
                CornerRadius="9"
                Background="#B3000000">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <FontIcon Glyph="&#xE768;" FontSize="10" Foreground="White" />
                <TextBlock Text="{x:Bind PlayCountText}" FontSize="11" Foreground="White" />
              </StackPanel>
            </Border>
          </Grid>
        </Border>

        <TextBlock
            Grid.Row="1"
            Text="{x:Bind Name}"
            Width="160"
            FontSize="13"
            FontFamily="{StaticResource AppUiFontBold}" FontWeight="Bold"
            Margin="2,9,2,0"
            MaxLines="2"
            TextWrapping="Wrap"
            TextAlignment="Center"
            TextTrimming="CharacterEllipsis" />
      </Grid>
    </DataTemplate>
  </Page.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel
        Orientation="Horizontal"
        Spacing="12"
        Margin="24,16,24,12"
        VerticalAlignment="Center">
      <TextBlock Text="{x:Bind L('历史记录')}" FontSize="20" FontFamily="{StaticResource AppUiFontBold}" FontWeight="Bold" />
      <TextBlock x:Name="CountText" FontSize="13" Opacity="0.55" VerticalAlignment="Center" />
    </StackPanel>

    <ScrollViewer
        x:Name="PageScroll"
        Grid.Row="1"
        Padding="0,0,0,20"
        HorizontalScrollMode="Disabled"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto"
        SizeChanged="PageScroll_SizeChanged">
      <StackPanel>

        <Border
            x:Name="HeatCard"
            Margin="16,4,16,0"
            Padding="18,14,18,16"
            CornerRadius="10"
            Background="{ThemeResource LibraryCardFillBrush}"
            BorderBrush="{ThemeResource LibraryCardStrokeBrush}"
            BorderThickness="1">
          <Grid ColumnSpacing="24">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Row="0"
                Grid.ColumnSpan="2"
                Text="{x:Bind L('观看活动')}"
                FontSize="14"
                FontFamily="{StaticResource AppUiFontBold}" FontWeight="Bold"
                Margin="0,0,0,10" />

            <Grid Grid.Row="1" Grid.Column="0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <Canvas x:Name="MonthCanvas" Grid.Column="1" />

              <StackPanel
                  x:Name="WeekdayColumn"
                  Grid.Row="1"
                  Grid.Column="0"
                  Width="12"
                  Margin="0,0,8,0"
                  Spacing="3" />

              <StackPanel
                  x:Name="HeatWeeks"
                  Grid.Row="1"
                  Grid.Column="1"
                  Orientation="Horizontal"
                  Spacing="3" />
            </Grid>

            <Grid Grid.Row="2" Grid.Column="0" Margin="0,10,0,0">
              <TextBlock Text="{x:Bind L('每格代表一天')}" FontSize="12" Opacity="0.4" VerticalAlignment="Center" />
              <StackPanel
                  Orientation="Horizontal"
                  Spacing="4"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center">
                <TextBlock Text="{x:Bind L('少')}" FontSize="11" Opacity="0.45" Margin="0,0,2,0" VerticalAlignment="Center" />
                <StackPanel
                    x:Name="LegendSwatches"
                    Orientation="Horizontal"
                    Spacing="3"
                    VerticalAlignment="Center" />
                <TextBlock Text="{x:Bind L('多')}" FontSize="11" Opacity="0.45" Margin="2,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </Grid>

            <Border
                Grid.Row="1"
                Grid.Column="1"
                Grid.RowSpan="2"
                Width="1"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Center"
                Background="{ThemeResource LibraryCardStrokeBrush}" />

            <StackPanel
                Grid.Row="1"
                Grid.Column="2"
                Grid.RowSpan="2"
                VerticalAlignment="Center"
                Spacing="12">
              <Grid RowSpacing="9" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{x:Bind L('近一年播放')}" FontSize="12" Opacity="0.5" />
                <TextBlock x:Name="StatTotal" Grid.Row="0" Grid.Column="1" FontSize="12" FontFamily="{StaticResource AppUiFontBold}" FontWeight="Bold" HorizontalAlignment="Right" />

                <TextBlock Grid.Row="1" Text="{x:Bind L('活跃天数')}" FontSize="12" Opacity="0.5" />
                <TextBlock x:Name="StatDays" Grid.Row="1" Grid.Column="1" FontSize="12" FontFamily="{StaticResource AppUiFontBold}" FontWeight="Bold" HorizontalAlignment="Right" />

                <TextBlock Grid.Row="2" Text="{x:Bind L('最长连续')}" FontSize="12" Opacity="0.5" />
                <TextBlock x:Name="StatStreak" Grid.Row="2" Grid.Column="1" FontSize="12" FontFamily="{StaticResource AppUiFontBold}" FontWeight="Bold" HorizontalAlignment="Right" />

                <TextBlock Grid.Row="3" Text="{x:Bind L('最近观看')}" FontSize="12" Opacity="0.5" />
                <TextBlock x:Name="StatLast" Grid.Row="3" Grid.Column="1" FontSize="12" FontFamily="{StaticResource AppUiFontBold}" FontWeight="Bold" HorizontalAlignment="Right" />
              </Grid>
            </StackPanel>

          </Grid>
        </Border>

        <Button
            x:Name="RecentHeader"
            Margin="16,14,16,0"
            Tag="recent"
            Click="Section_Click"
            Style="{StaticResource SectionHeaderStyle}"
            Visibility="Collapsed">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <FontIcon x:Name="RecentChevron" Glyph="&#xE70D;" FontSize="9" Opacity="0.5" VerticalAlignment="Center" />
            <TextBlock Text="{x:Bind L('最近看过')}" FontSize="14" FontFamily="{StaticResource AppUiFontBold}" FontWeight="Bold" />
            <TextBlock x:Name="RecentCountText" FontSize="12" Opacity="0.5" Margin="0,2,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <GridView
            x:Name="HistoryGrid"
            Margin="16,2,16,20"
            IsItemClickEnabled="True"
            ItemClick="HistoryGrid_ItemClick"
            SelectionMode="None"
            ItemContainerStyle="{StaticResource PosterItemStyle}"
            ItemTemplate="{StaticResource HistoryPosterTemplate}"
            ScrollViewer.VerticalScrollMode="Disabled"
            ScrollViewer.VerticalScrollBarVisibility="Disabled">
          <GridView.ItemsPanel>
            <ItemsPanelTemplate>
              <ItemsWrapGrid Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </GridView.ItemsPanel>
        </GridView>

        <StackPanel
            x:Name="RecentEmpty"
            Margin="16,26,16,0"
            Spacing="6"
            Visibility="Collapsed">
          <TextBlock Text="{x:Bind L('还没有观看记录')}" FontSize="16" Opacity="0.8" HorizontalAlignment="Center" />
          <TextBlock Text="{x:Bind L('播放过的视频会按时间出现在这里')}" FontSize="13" Opacity="0.5" HorizontalAlignment="Center" />
        </StackPanel>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
