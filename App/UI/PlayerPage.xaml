<Page
    x:Class="FilmField.Views.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid
      x:Name="Root"
      Background="#000000"
      PointerMoved="Root_PointerMoved"
      PointerExited="Root_PointerExited"
      DoubleTapped="Root_DoubleTapped">

    <Border x:Name="PageBackdrop" Background="{ThemeResource AppBackgroundBrush}" />

    <MediaPlayerElement
        x:Name="PlayerElement"
        AreTransportControlsEnabled="False"
        Stretch="Uniform" />

    <Border
        x:Name="SwitchCover"
        Background="#000000"
        IsHitTestVisible="False"
        Visibility="Collapsed" />

    <TextBlock
        x:Name="EmptyHint"
        Text="{x:Bind L('拖放视频文件到窗口，或点击下方的打开按钮')}"
        FontSize="13"
        Opacity="0.5"
        HorizontalAlignment="Center"
        VerticalAlignment="Center" />

    <Border
        x:Name="TitleHost"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        Margin="16,14"
        Visibility="Collapsed">
      <TextBlock
          x:Name="TitleText"
          MaxWidth="760"
          FontSize="24"
          Foreground="White"
          VerticalAlignment="Center"
          TextTrimming="CharacterEllipsis" />
    </Border>

    <TextBlock
        x:Name="SubtitleText"
        HorizontalAlignment="Center"
        VerticalAlignment="Bottom"
        Margin="24,0,24,96"
        MaxWidth="900"
        FontSize="20"
        Foreground="White"
        TextWrapping="Wrap"
        TextAlignment="Center" />

    <Image
        x:Name="SubtitleImage"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        Stretch="Fill"
        IsHitTestVisible="False"
        Visibility="Collapsed" />

    <Border
        x:Name="RateOsd"
        HorizontalAlignment="Center"
        VerticalAlignment="Top"
        Margin="0,48,0,0"
        Padding="14,6,14,8"
        CornerRadius="8"
        Background="#A6000000"
        IsHitTestVisible="False"
        Visibility="Collapsed">
      <TextBlock
          x:Name="RateOsdText"
          FontSize="26"
          FontFamily="{StaticResource AppUiFontBold}" FontWeight="Bold"
          Foreground="White" />
    </Border>

    <Border
        x:Name="VolumeOsd"
        HorizontalAlignment="Center"
        VerticalAlignment="Top"
        Margin="0,48,0,0"
        Padding="14,6,14,8"
        CornerRadius="8"
        Background="#A6000000"
        IsHitTestVisible="False"
        Visibility="Collapsed">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <FontIcon
            x:Name="VolumeOsdIcon"
            FontSize="20"
            Glyph="&#xE767;"
            Foreground="White" />
        <TextBlock
            x:Name="VolumeOsdText"
            FontSize="26"
            FontFamily="{StaticResource AppUiFontBold}" FontWeight="Bold"
            Foreground="White"
            VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <Border
        x:Name="PreviewPopup"
        CornerRadius="8"
        Padding="6,4"
        VerticalAlignment="Bottom"
        HorizontalAlignment="Left"
        Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
        Visibility="Collapsed">
      <StackPanel Spacing="4">
        <Border
            Width="160"
            Height="90"
            CornerRadius="4"
            Background="{ThemeResource CardPlaceholderBrush}">
          <Image
              x:Name="PreviewImage"
              Stretch="UniformToFill"
              Visibility="Collapsed" />
        </Border>
        <TextBlock x:Name="PreviewTime" FontSize="12" HorizontalAlignment="Center" />
      </StackPanel>
    </Border>

    <Border
        x:Name="BarGlassHost"
        IsHitTestVisible="False"
        Background="Transparent" />

    <Grid x:Name="OverlayHost" VerticalAlignment="Bottom" Margin="14,0,14,14">
      <Border
          x:Name="ControlBarBorder"
          CornerRadius="10"
          Padding="16,8,16,8"
          Background="{ThemeResource LibraryCardFillBrush}">
        <Grid RowSpacing="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="CurrentTimeText"
                Text="0:00"
                FontSize="12"
                Opacity="0.8"
                VerticalAlignment="Center"
                Margin="0,0,10,0" />
            <Slider
                x:Name="ProgressSlider"
                Grid.Column="1"
                MinHeight="24"
                IsThumbToolTipEnabled="False"
                PointerEntered="ProgressSlider_PointerEntered"
                PointerExited="ProgressSlider_PointerExited" />
            <TextBlock
                x:Name="DurationText"
                Grid.Column="2"
                Text="0:00"
                FontSize="12"
                Opacity="0.8"
                VerticalAlignment="Center"
                Margin="10,0,0,0" />
          </Grid>

          <Grid Grid.Row="1">
            <Grid.Resources>
              <Style x:Key="TransportButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="MinWidth" Value="38" />
                <Setter Property="Height" Value="38" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
              </Style>
            </Grid.Resources>
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Button x:Name="PrevButton" Style="{StaticResource TransportButton}" Click="PrevButton_Click" ToolTipService.ToolTip="{x:Bind L('上一个')}">
                <FontIcon FontSize="16" Glyph="&#xE892;" />
              </Button>
              <Button
                  x:Name="PlayButton"
                  Style="{StaticResource TransportButton}"
                  Click="PlayButton_Click"
                  CornerRadius="4"
                  Background="{ThemeResource AccentFillColorDefaultBrush}"
                  ToolTipService.ToolTip="{x:Bind L('播放/暂停')}">
                <Button.Resources>
                  <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="AccentFillColorDefaultBrush" />
                  <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="AccentFillColorDefaultBrush" />
                </Button.Resources>
                <FontIcon x:Name="PlayIcon" FontSize="16" Glyph="&#xE768;" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
              </Button>
              <Button x:Name="NextButton" Style="{StaticResource TransportButton}" Click="NextButton_Click" ToolTipService.ToolTip="{x:Bind L('下一个')}">
                <FontIcon FontSize="16" Glyph="&#xE893;" />
              </Button>
              <Button x:Name="RepeatButton" Style="{StaticResource TransportButton}" Click="RepeatButton_Click" Margin="8,0,0,0" ToolTipService.ToolTip="{x:Bind L('循环模式')}">
                <FontIcon x:Name="RepeatIcon" FontSize="16" Glyph="&#xE8EE;" />
              </Button>
              <Button x:Name="ShuffleButton" Style="{StaticResource TransportButton}" Click="ShuffleButton_Click" ToolTipService.ToolTip="{x:Bind L('随机播放')}">
                <FontIcon x:Name="ShuffleIcon" FontSize="16" Glyph="&#xE8B1;" />
              </Button>
              <Button
                  x:Name="EpisodeButton"
                  Style="{StaticResource TransportButton}"
                  Margin="8,0,0,0"
                  Visibility="Collapsed"
                  ToolTipService.ToolTip="{x:Bind L('选集')}">
                <Button.Flyout>
                  <Flyout x:Name="EpisodeFlyout" Placement="Top" Opened="EpisodeFlyout_Opened">
                    <StackPanel Width="300" Spacing="8">
                      <TextBlock x:Name="EpisodeHeader" Text="{x:Bind L('播放列表')}" FontSize="13" FontFamily="{StaticResource AppUiFontBold}" FontWeight="Bold" Margin="2,0,0,0" />
                      <ScrollViewer
                          MaxHeight="320"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="EpisodeList" Spacing="2" />
                      </ScrollViewer>
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
                <FontIcon FontSize="16" Glyph="&#xE8FD;" />
              </Button>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
              <Button x:Name="MuteButton" Style="{StaticResource TransportButton}" Click="MuteButton_Click" ToolTipService.ToolTip="{x:Bind L('静音')}">
                <FontIcon x:Name="VolumeIcon" FontSize="16" Glyph="&#xE767;" />
              </Button>
              <Slider
                  x:Name="VolumeSlider"
                  Width="110"
                  Minimum="0"
                  Maximum="100"
                  IsThumbToolTipEnabled="False"
                  VerticalAlignment="Center"
                  ValueChanged="VolumeSlider_ValueChanged"
                  KeyUp="VolumeSlider_KeyUp" />
              <Button x:Name="RateButton" Style="{StaticResource TransportButton}" ToolTipService.ToolTip="{x:Bind L('播放速度')}">
                <Button.Flyout>
                  <MenuFlyout>
                    <MenuFlyoutItem Text="0.25×" Tag="0.25" Click="RateItem_Click" />
                    <MenuFlyoutItem Text="0.5×" Tag="0.5" Click="RateItem_Click" />
                    <MenuFlyoutItem Text="0.75×" Tag="0.75" Click="RateItem_Click" />
                    <MenuFlyoutItem Text="1.0×" Tag="1.0" Click="RateItem_Click" />
                    <MenuFlyoutItem Text="1.25×" Tag="1.25" Click="RateItem_Click" />
                    <MenuFlyoutItem Text="1.5×" Tag="1.5" Click="RateItem_Click" />
                    <MenuFlyoutItem Text="2.0×" Tag="2.0" Click="RateItem_Click" />
                    <MenuFlyoutItem Text="2.5×" Tag="2.5" Click="RateItem_Click" />
                    <MenuFlyoutItem Text="3.0×" Tag="3.0" Click="RateItem_Click" />
                  </MenuFlyout>
                </Button.Flyout>
                <TextBlock x:Name="RateText" Text="1.0×" FontSize="16" FontFamily="{StaticResource AppUiFontBold}" FontWeight="Bold" />
              </Button>
              <Button x:Name="SubtitleButton" Style="{StaticResource TransportButton}" ToolTipService.ToolTip="{x:Bind L('字幕')}">
                <Button.Flyout>
                  <MenuFlyout x:Name="SubtitleMenu">
                    <MenuFlyoutItem Text="{x:Bind L('加载字幕文件...')}" Click="LoadSubtitleItem_Click" />
                    <MenuFlyoutItem Text="{x:Bind L('关闭字幕')}" Click="CloseSubtitleItem_Click" />
                  </MenuFlyout>
                </Button.Flyout>
                <FontIcon FontSize="18" Glyph="&#xE7F0;" />
              </Button>
              <Button x:Name="ScreenshotButton" Style="{StaticResource TransportButton}" Click="ScreenshotButton_Click" ToolTipService.ToolTip="{x:Bind L('截图')}">
                <FontIcon FontSize="16" Glyph="&#xE722;" />
              </Button>
              <Button x:Name="OpenButton" Style="{StaticResource TransportButton}" Click="OpenButton_Click" ToolTipService.ToolTip="{x:Bind L('打开文件')}">
                <FontIcon FontSize="18" Glyph="&#xE8E5;" />
              </Button>
              <Button x:Name="FullscreenButton" Style="{StaticResource TransportButton}" Click="FullscreenButton_Click" ToolTipService.ToolTip="{x:Bind L('窗口全屏')}">
                <FontIcon x:Name="FullscreenIcon" FontSize="18" Glyph="&#xE9A6;" />
              </Button>
              <Button x:Name="BarFullscreenButton" Style="{StaticResource TransportButton}" Click="BarFullscreenButton_Click" ToolTipService.ToolTip="{x:Bind L('全屏')}">
                <FontIcon x:Name="BarFullscreenIcon" FontSize="16" Glyph="&#xE740;" />
              </Button>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Page>
