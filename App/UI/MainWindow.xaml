<Window
    x:Class="FilmField.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FilmField">

  <Grid
      x:Name="RootGrid"
      AllowDrop="True"
      DragOver="RootGrid_DragOver"
      Drop="RootGrid_Drop"
      Background="{ThemeResource AppBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition x:Name="TitleRow" Height="40" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid x:Name="AppTitleBar" Height="40" Background="Transparent">
      <StackPanel Orientation="Horizontal" Margin="14,0,0,0" Spacing="9" VerticalAlignment="Center">
        <Viewbox Width="20" Height="20">
          <Canvas Width="1024" Height="1024">
            <Rectangle Width="1024" Height="1024" RadiusX="200" RadiusY="200" Fill="#E8DCC8" />
            <Rectangle Canvas.Left="90" Canvas.Top="100" Width="844" Height="824" RadiusX="60" RadiusY="60" Fill="#55504C" />
            <Rectangle Canvas.Left="118" Canvas.Top="128" Width="147" Height="172" RadiusX="35" RadiusY="35" Fill="#E8DCC8" />
            <Rectangle Canvas.Left="118" Canvas.Top="327" Width="147" Height="172" RadiusX="35" RadiusY="35" Fill="#E8DCC8" />
            <Rectangle Canvas.Left="118" Canvas.Top="525" Width="147" Height="172" RadiusX="35" RadiusY="35" Fill="#E8DCC8" />
            <Rectangle Canvas.Left="118" Canvas.Top="724" Width="147" Height="172" RadiusX="35" RadiusY="35" Fill="#E8DCC8" />
            <Rectangle Canvas.Left="759" Canvas.Top="128" Width="147" Height="172" RadiusX="35" RadiusY="35" Fill="#E8DCC8" />
            <Rectangle Canvas.Left="759" Canvas.Top="327" Width="147" Height="172" RadiusX="35" RadiusY="35" Fill="#E8DCC8" />
            <Rectangle Canvas.Left="759" Canvas.Top="525" Width="147" Height="172" RadiusX="35" RadiusY="35" Fill="#E8DCC8" />
            <Rectangle Canvas.Left="759" Canvas.Top="724" Width="147" Height="172" RadiusX="35" RadiusY="35" Fill="#E8DCC8" />
            <Path Data="M474,418 L594,512 L474,606 Z" Stroke="#E8DCC8" StrokeThickness="44" StrokeLineJoin="Round" />
          </Canvas>
        </Viewbox>
        <TextBlock Text="FilmField" FontSize="15" FontFamily="{StaticResource AppUiFontBold}" FontWeight="Bold" VerticalAlignment="Center" />
      </StackPanel>
    </Grid>

    <NavigationView
        x:Name="Nav"
        Grid.Row="1"
        IsBackButtonVisible="Collapsed"
        IsPaneToggleButtonVisible="True"
        PaneToggleButtonStyle="{StaticResource PaneToggleButtonStyle}"
        PaneDisplayMode="Left"
        OpenPaneLength="213"
        IsSettingsVisible="True"
        AllowDrop="True"
        DragOver="Nav_DragOver"
        DragLeave="Nav_DragLeave"
        Drop="Nav_Drop"
        ItemInvoked="Nav_ItemInvoked"
        SelectionChanged="Nav_SelectionChanged">
      <NavigationView.MenuItems>
        <NavigationViewItem Tag="player" Content="播放">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE768;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Tag="queue" Content="播放队列">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE8FD;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItemSeparator />
        <NavigationViewItem Tag="home" Content="主页">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE80F;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItemSeparator />
        <NavigationViewItem
            x:Name="NewLibraryItem"
            Tag="new-library"
            Content="新建库"
            SelectsOnInvoked="False">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE710;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.MenuItems>
      <NavigationView.FooterMenuItems>
        <NavigationViewItemSeparator />
        <NavigationViewItem Tag="history" Content="历史记录">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE81C;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.FooterMenuItems>
      <Frame x:Name="ContentFrame" />
    </NavigationView>

    <local:PaneThumbBorder
        x:Name="PaneThumb"
        Grid.Row="1"
        Width="6"
        HorizontalAlignment="Left"
        DragMove="PaneThumb_DragMove"
        DragEnd="PaneThumb_DragEnd">
      <local:PaneThumbBorder.Template>
        <ControlTemplate TargetType="local:PaneThumbBorder">
          <Rectangle Fill="Transparent" />
        </ControlTemplate>
      </local:PaneThumbBorder.Template>
    </local:PaneThumbBorder>
  </Grid>
</Window>
