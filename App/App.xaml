<Application
    x:Class="FilmField.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
        <ResourceDictionary Source="ms-appx:///App/UI/AppStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <FontFamily x:Key="AppUiFont">ms-appx:///Resources/Fonts/HarmonyOS_Sans_SC_Medium.ttf#HarmonyOS Sans SC Medium</FontFamily>
      <FontFamily x:Key="AppUiFontBold">ms-appx:///Resources/Fonts/HarmonyOS_Sans_SC_Bold.ttf#HarmonyOS Sans SC</FontFamily>
      <FontFamily x:Key="ContentControlThemeFontFamily">{StaticResource AppUiFont}</FontFamily>

      <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppUiFont}" />
      </Style>

      <Style x:Key="BaseTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppUiFont}" />
        <Setter Property="FontSize" Value="{StaticResource BodyTextBlockFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineStackingStrategy" Value="MaxHeight" />
        <Setter Property="TextLineBounds" Value="Full" />
      </Style>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F3F3" />
          <SolidColorBrush x:Key="AppBackdropTintBrush" Color="#B4F5F5F5" />
          <SolidColorBrush x:Key="CardPlaceholderBrush" Color="#E7E7E7" />
          <SolidColorBrush x:Key="LibraryCardFillBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="LibraryCardStrokeBrush" Color="#D4D4D4" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="AppBackgroundBrush" Color="#101010" />
          <SolidColorBrush x:Key="AppBackdropTintBrush" Color="#99141414" />
          <SolidColorBrush x:Key="CardPlaceholderBrush" Color="#1C1C1C" />
          <SolidColorBrush x:Key="LibraryCardFillBrush" Color="#232323" />
          <SolidColorBrush x:Key="LibraryCardStrokeBrush" Color="#323232" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
          <SolidColorBrush x:Key="AppBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
          <SolidColorBrush x:Key="CardPlaceholderBrush" Color="{ThemeResource SystemColorWindowColor}" />
          <SolidColorBrush x:Key="LibraryCardFillBrush" Color="{ThemeResource SystemColorWindowColor}" />
          <SolidColorBrush x:Key="LibraryCardStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

    </ResourceDictionary>
  </Application.Resources>
</Application>
